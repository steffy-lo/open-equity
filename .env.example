PORT=5000
STARTING_CASH=100000
TRADING_FEE_PCT=0.001
BENCHMARK_TICKER=SPY
PRICE_CACHE_TTL=60
MIN_SIGNAL_CONFIDENCE=0.70
SCREEN_SCHEDULE_CRON=0 20 * * 1-5
BENCHMARK_SNAPSHOT_CRON=0 21 * * 1-5
DB_PATH=open_equity.db
WATCHLIST_PATH=watchlist.json

# ── Autonomous pipeline ────────────────────────────────────────
# No AI API key needed, OpenClaw handles all reasoning.

# Execution agent risk params (defaults shown)
EXEC_MAX_POSITION_PCT=0.10
EXEC_MAX_EXPOSURE_PCT=0.80
EXEC_STOP_LOSS_PCT=0.08
EXEC_TAKE_PROFIT_PCT=0.20
EXEC_MAX_TRADES_PER_DAY=3

# Blog output / forwarding
BLOG_OUTPUT_DIR=blogs/trading
BLOG_FORWARD_TOPIC=telegram:-1003765209717:3
BLOG_FORWARD_SUMMARY_MAX_CHARS=4000

# Pipeline update notifications
TRADE_UPDATE_CHANNEL=telegram
TRADE_UPDATE_ACCOUNT_ID=default
TRADE_UPDATE_TOPIC=telegram:-1003765209717:428
RESEARCH_UPDATE_CHANNEL=telegram
RESEARCH_UPDATE_ACCOUNT_ID=default
RESEARCH_UPDATE_TOPIC=telegram:-1003765209717:428
OPENCLAW_GATEWAY_URL=http://127.0.0.1:18789

# US session pipeline cron schedules (America/New_York, 5-field)
RESEARCH_CONTEXT_CRON=0 7 * * 1
US_PREOPEN_SCREEN_CRON=15 9 * * 1-5
US_MIDDAY_SCREEN_CRON=45 12 * * 1-5
ENTRY_PASS_CRON=35 9 * * 1-5
EXIT_PASS_CRON=45 15 * * 1-5
BLOG_CONTEXT_CRON=0 18 * * 0

# HK session pipeline cron schedules (Asia/Hong_Kong, 5-field)
HK_RESEARCH_CONTEXT_CRON=0 7 * * 1
HK_PREOPEN_SCREEN_CRON=15 9 * * 1-5
HK_MIDDAY_SCREEN_CRON=45 12 * * 1-5
HK_ENTRY_PASS_CRON_AM=30 9 * * 1-5
HK_EXIT_PASS_CRON_AM=0 12 * * 1-5
HK_ENTRY_PASS_CRON_PM=0 13 * * 1-5
HK_EXIT_PASS_CRON_PM=0 16 * * 1-5
