PORT=5000
STARTING_CASH=100000
TRADING_FEE_PCT=0.001
BENCHMARK_TICKER=SPY
PRICE_CACHE_TTL=60
MIN_SIGNAL_CONFIDENCE=0.70
SCREEN_SCHEDULE_CRON=0 20 * * 1-5
SCREEN_INTRADAY_CRON=*/15 9-16 * * 1-5
BENCHMARK_SNAPSHOT_CRON=0 21 * * 1-5
DB_PATH=open_equity.db
WATCHLIST_PATH=watchlist.json

# ── Autonomous pipeline ────────────────────────────────────────
# No AI API key needed — OpenClaw handles all reasoning.
 
# Execution agent risk params (defaults shown)
EXEC_MAX_POSITION_PCT=0.10      # max 10% of portfolio per name
EXEC_MAX_EXPOSURE_PCT=0.80      # stop buying above 80% equity exposure
EXEC_STOP_LOSS_PCT=0.08         # sell if down 8% from avg cost
EXEC_TAKE_PROFIT_PCT=0.20       # sell if up 20% from avg cost
EXEC_MAX_TRADES_PER_DAY=3       # max new buy orders per day
 
# Blog output directory
BLOG_OUTPUT_DIR=blogs/trading
 
# Pipeline cron schedules (America/New_York, 5-field)
RESEARCH_CONTEXT_CRON=0 7 * * 1        # Monday 7am — prep research context
ENTRY_PASS_CRON=35 9 * * 1-5           # Mon–Fri 9:35am — entries
EXIT_PASS_CRON=45 15 * * 1-5           # Mon–Fri 3:45pm — exits
BLOG_CONTEXT_CRON=0 18 * * 0           # Sunday 6pm — prep blog context